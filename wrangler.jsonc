
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "quizflare",
	"main": "worker/index.ts",
	"compatibility_date": "2026-01-28",
	"assets": {
		"not_found_handling": "single-page-application",
		"binding": "ASSETS",
		"run_worker_first": ["/api/*", "/ws/*"]
	},

	"durable_objects": {
		"bindings": [
			{ "name": "ROOM_DO", "class_name": "RoomDO" },
			{ "name": "PIN_REGISTRY_DO", "class_name": "PinRegistryDO" }
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["RoomDO", "PinRegistryDO"]
		}
	],

	"observability": {
		"traces": {
			"enabled": true
		},
		"enabled": true
	},
	"placement": {  "mode": "smart" }
}